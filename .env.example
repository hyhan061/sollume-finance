# 2026-10-14 hoyeon.han: 이전 구성 보존(실행되지 않음)
# # .env.example
# # 2026-06-11 hoyeon.han: 발주내역 API 인증 키 설정 예시 (신규)
# #
# # 사용법:
# #   1) 이 파일을 같은 위치에 .env 라는 이름으로 복사한다 (cp .env.example .env)
# #   2) 아래 키를 새로 생성한 값으로 교체한다:
# #      python -c "import secrets; print(secrets.token_urlsafe(32))"
# #   3) docker compose up -d 시 자동으로 sollume-api 컨테이너에 주입된다
# #
# # 주의:
# #   - .env 는 .gitignore 에 등록되어 있어 git 에 올라가지 않는다 (절대 커밋 금지)
# #   - 키가 유출되면 새로 생성해 교체하고 컨테이너를 재시작한다
# #   - OpenClaw(요청 측)에는 같은 키를 X-API-Key 헤더로 보내도록 설정한다
#
# ORDER_API_KEY=여기에_생성한_키를_입력하세요

# 2026-10-14 hoyeon.han: 필수 인증·내부 포트 제한 구성
# 사용법: .env로 복사한 뒤 실제 운영 값으로 채운다. .env는 커밋하지 않는다.
# .env 전체를 명령창에 출력하거나 Docker compose config 출력에 키를 노출하지 않는다.
# 2026-10-19 hoyeon.han: 확정한 office1 공개 도메인으로 통일한다.
# AUTH_PUBLIC_ORIGIN=https://sollumeesthe.com
AUTH_PUBLIC_ORIGIN=https://office1.sollumeesthe.com
# .venv311/bin/python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 생성된 값을 비공개 채널에서 아래에 설정하고, DB와 분리하여 안전하게 백업한다.
AUTH_ENCRYPTION_KEY=
# 기존 발주내역 API 키를 유지한다. 직원 로그인 키와는 별개다.
ORDER_API_KEY=
