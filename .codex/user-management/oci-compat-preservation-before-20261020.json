  "remote_capture_source": "import hashlib,json,os,pathlib,stat,subprocess\napp=pathlib.Path('/home/ubuntu/sollume-finance')\ndef digest(p):\n    h=hashlib.sha256()\n    with p.open('rb') as stream:\n        for block in iter(lambda:stream.read(1024*1024),b''):h.update(block)\n    return h.hexdigest()\nfiles={}\nfor relative in ['.env','docker-compose.cloud.yml','database/users.db','database/customer_master.db','거래처마스터.xlsx','scripts/release_snapshot.py','deploy-oracle.sh','rollback-oracle.sh']:\n    p=app/relative\n    files[relative]={'exists':p.exists(),'sha256':digest(p) if p.is_file() else None,'mode':stat.S_IMODE(p.stat().st_mode) if p.exists() else None}\nbackup=app/'database/backups/releases/manual-before-auth-20261019_141607'\nfor name in ['application.tar.gz','images.tar','containers.json']:\n    p=backup/name;files['backup/'+name]={'sha256':digest(p),'mode':stat.S_IMODE(p.stat().st_mode),'bytes':p.stat().st_size}\ntrees={}\nfor relative in ['processed','uploads','order_data']:\n    root=app/relative;records=[]\n    for p in sorted(root.rglob('*')):\n        if p.is_symlink():records.append((str(p.relative_to(root)),'link',os.readlink(p)))\n        elif p.is_file():records.append((str(p.relative_to(root)),'file',digest(p)))\n    trees[relative]={'files':len(records),'sha256':hashlib.sha256(json.dumps(records,ensure_ascii=False).encode()).hexdigest()}\nnginx={}\nfor root in [pathlib.Path('/etc/nginx'),pathlib.Path('/etc/letsencrypt/renewal'),pathlib.Path('/etc/letsencrypt/renewal-hooks')]:\n    for p in sorted(root.rglob('*')):\n        if p.is_symlink():nginx[str(p)]={'link':os.readlink(p)}\n        elif p.is_file():nginx[str(p)]={'sha256':digest(p),'mode':stat.S_IMODE(p.stat().st_mode)}\nfor name in ['sol-fin.duckdns.org','sollume-finance.duckdns.org','sollume-n8n.duckdns.org','office1.sollumeesthe.com']:\n    p=pathlib.Path('/etc/letsencrypt/live')/name/'fullchain.pem';nginx[str(p)]={'sha256':digest(p)}\ncontainers=[]\nfor name in ['sollume-finance-app','sollume-finance-api','n8n','goodsfoundry']:\n    containers.append(json.loads(subprocess.check_output(['docker','inspect','--format','{\"name\":{{json .Name}},\"id\":{{json .Id}},\"image\":{{json .Image}},\"started\":{{json .State.StartedAt}},\"restarts\":{{.RestartCount}},\"running\":{{.State.Running}}}',name],text=True)))\nprint(json.dumps({'files':files,'business_trees':trees,'nginx':nginx,'containers':containers},ensure_ascii=False))\n"
